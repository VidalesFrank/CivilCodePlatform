# -----------------------------------------------------------------------------
# CivilCode Studio — ejemplo de variables de entorno
# Copia este archivo a .env y completa los valores. NUNCA commitees .env real.
# -----------------------------------------------------------------------------

# ---- Core ----
APP_ENV=development
APP_NAME="CivilCode Studio"
APP_LOG_LEVEL=INFO

# ---- API (FastAPI) ----
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-use-openssl-rand-hex-32
API_JWT_ALGORITHM=HS256
API_JWT_ACCESS_TTL_MINUTES=15
API_JWT_REFRESH_TTL_DAYS=30
API_CORS_ORIGINS=http://localhost:3000

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civilcode
POSTGRES_USER=civilcode
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://civilcode:change-me@localhost:5432/civilcode

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Object storage (MinIO en dev) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=civilcode
S3_SECRET_KEY=change-me
S3_BUCKET=civilcode-storage
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="CivilCode Studio"
